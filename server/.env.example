# Copia este archivo como server/.env y llena los valores.
# server/.env está en .gitignore: nunca se sube al repositorio.

# --- Base de datos MySQL -------------------------------------------------
# Deben coincidir con la conexión que usas en MySQL Workbench.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartcut

# --- Servidor ------------------------------------------------------------
# Si cambias este puerto, cambia también API_PORT en src/core/config/env.ts
PORT=4000

# --- Autenticación -------------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
