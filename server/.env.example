# Copia este archivo como server/.env y llena los valores.
# server/.env está en .gitignore: nunca se sube al repositorio.

# --- Base de datos MySQL -------------------------------------------------
# Deben coincidir con la conexión que usas en MySQL Workbench.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartcut

# --- Servidor ------------------------------------------------------------
# Si cambias este puerto, cambia también API_PORT en src/core/config/env.ts
PORT=4000

# --- Autenticación -------------------------------------------------------
# Cadena larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Asistente financiero Gemini ------------------------------------------
# Crea la clave en Google AI Studio. Nunca la expongas en Expo ni la subas al
# repositorio: solo la consume el backend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000

# --- Google Places API ----------------------------------------------------
# Crea la clave en: https://console.cloud.google.com/
# Habilitar en la misma clave: Places API + Geocoding API
# Restringe la clave a "Aplicaciones de servidor" (IP del servidor en producción).
# Nunca la expongas en Expo ni la subas al repositorio.
GOOGLE_PLACES_KEY=

# --- CORS ----------------------------------------------------------------
# Orígenes permitidos separados por coma.
# Agrega el dominio de la web pública y el de la app Expo.
# En producción: https://smartcut.co,https://api.smartcut.co
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006
